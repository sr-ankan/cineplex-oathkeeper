# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token

# Prefix for commands such as !watch
COMMAND_PREFIX=!

# Polling interval in seconds
POLL_INTERVAL=30

# Star Cineplex's public API
CINEPLEX_API_BASE=https://api.kichole.com
CINEPLEX_SITE_URL=https://starcineplex.com